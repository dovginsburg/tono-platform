<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.1</string>
	<key>CFBundleVersion</key>
	<string>127</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.tonoit.app.googlesignin</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<!-- Reversed Google client ID, supplied at provider-activation
				     time via the $(GID_URL_SCHEME) build setting. Empty by default
				     (fail closed); no sibling identifier is ever embedded. -->
				<string>$(GID_URL_SCHEME)</string>
			</array>
		</dict>
	</array>
	<key>GIDClientID</key>
	<string>$(GID_CLIENT_ID)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>shortcuts</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSContactsUsageDescription</key>
	<string>Tono uses contacts you choose to create local recipient profiles for personalized coaching.</string>
	<key>REVENUECAT_MODE</key>
	<string>$(REVENUECAT_MODE)</string>
	<key>REVENUECAT_PUBLIC_SDK_KEY</key>
	<string>$(REVENUECAT_PUBLIC_SDK_KEY)</string>
	<key>TONO_PASSKEYS_ENABLED</key>
	<string>$(TONO_PASSKEYS_ENABLED)</string>
	<key>TONO_WEBAUTHN_RP_ID</key>
	<string>$(TONO_WEBAUTHN_RP_ID)</string>
	<key>TonoCanonicalSHA</key>
	<string>$(TONO_CANONICAL_SHA)</string>
	<key>TonoSchemaRevision</key>
	<string>$(TONO_SCHEMA_REVISION)</string>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
